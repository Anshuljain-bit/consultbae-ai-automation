    {
      "parameters": {
        "jsCode": "const norm = (s) => String(s || '').trim().toLowerCase();\nconst phoneKey = (s) => { const d = String(s || '').replace(/\\D/g, ''); return d.length >= 10 ? d.slice(-10) : d; };\n\nconst existing = $('Read Existing Rows').all()\n  .map(i => i.json)\n  .filter(r => r && Object.keys(r).length > 0);\n\nconst emails = new Set(existing.map(r => norm(r.Email)).filter(Boolean));\nconst phones = new Set(existing.map(r => phoneKey(r.Phone)).filter(Boolean));\n\nconst rows = $('Extract CSV3').all().map(i => i.json);\n\nreturn rows.map(r => {\n  const email = norm(r.Email);\n  const phone = phoneKey(r.Phone);\n  const is_duplicate = (!!email && emails.has(email)) || (!!phone && phones.has(phone));\n  return { json: { ...r, is_duplicate } };\n});"
      },
