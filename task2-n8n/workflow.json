      "parameters": {
        "jsCode": "const outputs = $input.all();\nconst rows = $('Detect Duplicates').all()\n  .map(i => i.json)\n  .filter(r => r && Object.keys(r).length > 0 && r.is_duplicate !== true);\n\nreturn outputs.map((o, idx) => {\n  const row = { ...(rows[idx] || {}) };\n  delete row.is_duplicate;\n  row['Summary '] = String(o.json.output || o.json.text || '').trim();\n  return { json: row };\n});"
      },
