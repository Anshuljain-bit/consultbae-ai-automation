        "jsCode": "const item = $input.first();\n\nif (!item.binary?.file && !item.binary?.data) {\n  throw new Error('No CSV file found. Expected binary property file or data.');\n}\n\nif (item.binary.file && !item.binary.data) {\n  item.binary.data = item.binary.file;\n}\n\nreturn item;"
